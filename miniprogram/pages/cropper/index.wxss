.cropper-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  display: flex;
  flex-direction: column;
}

.crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 500rpx;
  height: 500rpx;
}

/* 裁剪区域 */
.cropper-area {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.cropper-image {
  width: 100%;
  height: 100%;
  transform-origin: center center;
}

/* 圆形裁剪遮罩 */
.cropper-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.cropper-box {
  width: 500rpx;
  height: 500rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.5);
}

/* 底部工具栏 */
.cropper-toolbar {
  height: 120rpx;
  display: flex;
  background: rgba(0, 0, 0, 0.85);
}

.cropper-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
}

.cropper-btn.confirm {
  color: #FF9B9B;
  font-weight: 600;
}
