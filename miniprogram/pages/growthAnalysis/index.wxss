page {
  background-color: #FFF5F5;
  min-height: 100vh;
}

.container {
  padding: 15rpx 0;
  font-family: PingFang SC;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  width: 90%;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF9B9B;
  margin-bottom: 8rpx;
}

.stat-value.red {
  color: #FF6B6B;
}

.stat-value.blue {
  color: #7EC8E3;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  width: 90%;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 6rpx;
}

.chart-wrap {
  width: 100%;
  height: 650rpx;
  position: relative;
}

.growth-chart {
  width: 100%;
  height: 100%;
  display: block;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 34rpx;
  color: #999;
}
