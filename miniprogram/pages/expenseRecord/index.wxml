<view class="container">
  <view class="top-bar" wx:if="{{records.length > 0}}">
    <view class="btn-stats" bindtap="goToStats">开支统计 ›</view>
  </view>

  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-header">
      <text class="header-date">日期</text>
      <text class="header-category">分类</text>
      <text class="header-amount">金额</text>
      <text class="header-action">操作</text>
    </view>
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="record-date">{{item.recordDate}}</view>
      <view class="record-category">
        <text class="category-tag">{{item.category}}</text>
      </view>
      <view class="record-amount">¥{{item.amount}}</view>
      <view class="record-actions">
        <view class="btn-edit" bindtap="onEdit" data-id="{{item._id}}" data-date="{{item.recordDate}}" data-category="{{item.category}}" data-amount="{{item.amount}}" data-remark="{{item.remark}}">修改</view>
        <view class="btn-delete" bindtap="onDelete" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </view>

  <view class="pagination" wx:if="{{total > 0}}">
    <view class="page-btn {{currentPage <= 1 ? 'disabled' : ''}}" bindtap="prevPage">‹</view>
    <view class="page-info"><text>{{currentPage}} / {{totalPages}}</text></view>
    <view class="page-btn {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">›</view>
    <view class="page-jump">
      <input class="page-input" type="number" placeholder="页码" value="{{jumpPage}}" bindinput="onJumpPageInput" />
      <view class="page-go" bindtap="jumpToPage">Go</view>
    </view>
  </view>

  <view class="list-footer" wx:if="{{total > 0}}">共 {{total}} 条记录</view>

  <view class="empty-state" wx:if="{{records.length === 0}}">
    <view class="empty-icon"></view>
    <view class="empty-text">暂无开支记录</view>
    <view class="empty-hint">点击下方按钮添加</view>
  </view>

  <view class="add-btn" bindtap="showAdd">+</view>

  <view class="modal-mask" wx:if="{{showModal}}">
    <view class="modal-close" bindtap="hideModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-title">{{isEdit ? '修改开支' : '记录开支'}}</view>
      </view>

      <picker mode="date" value="{{formDate}}" end="{{today}}" bindchange="onDateChange">
        <view class="form-item">
          <text class="form-label">日期</text>
          <text class="form-value">{{formDate}}</text>
          <text class="form-arrow">›</text>
        </view>
      </picker>

      <picker mode="selector" range="{{['饮食','日用品','服装','玩具教育','医疗','出行游玩','纪念','其他']}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="form-item">
          <text class="form-label">分类</text>
          <text class="form-value">{{formCategory || '请选择分类'}}</text>
          <text class="form-arrow">›</text>
        </view>
      </picker>

      <view class="form-item">
        <text class="form-label">金额</text>
        <input type="digit" placeholder="请输入金额" value="{{formAmount}}" bindinput="onAmountInput" class="form-input" />
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input placeholder="可选备注" value="{{formRemark}}" bindinput="onRemarkInput" class="form-input" />
      </view>

      <view class="modal-buttons">
        <view class="btn-cancel" bindtap="hideModal">取消</view>
        <view class="btn-confirm" bindtap="onConfirm">{{isEdit ? '修改' : '确定'}}</view>
      </view>
    </view>
  </view>
</view>
