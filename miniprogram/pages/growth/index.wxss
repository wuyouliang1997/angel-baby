page {
  background-color: #FFF5F5;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  font-family: PingFang SC;
}

/* 最新记录卡片 */
.latest-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  display: flex;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.latest-card.empty {
  justify-content: center;
}

.latest-item {
  flex: 1;
  text-align: center;
}

.latest-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.latest-value.red {
  color: #FF6B6B;
}

.latest-value.blue {
  color: #7EC8E3;
}

.latest-label {
  font-size: 24rpx;
  color: #999;
}

.empty-text {
  font-size: 30rpx;
  color: #ccc;
}

/* 功能菜单 */
.menu-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.record-growth-icon {
  background: linear-gradient(135deg, #7EC8E3, #A8D8EA);
}

.analysis-growth-icon {
  background: linear-gradient(135deg, #98D8AA, #B8E6C8);
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}
