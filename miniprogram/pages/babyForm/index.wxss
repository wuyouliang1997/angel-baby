page {
  background-color: #FFF5F5;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  font-family: PingFang SC;
}

.form-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.form-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}

.form-content {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* 头像选择 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 22rpx;
  color: #999;
}

/* 表单样式 */
.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 32rpx;
  color: #333;
  width: 180rpx;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 32rpx;
  color: #666;
  text-align: right;
}

.form-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  text-align: right;
}

/* 按钮样式 */
.form-buttons {
  display: flex;
  width: 100%;
  margin-top: 60rpx;
  gap: 20rpx;
  box-sizing: border-box;
}

.btn-cancel {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 32rpx;
  color: #666;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-confirm {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF9B9B, #FFB5B5);
  border-radius: 36rpx;
  font-size: 32rpx;
  color: #fff;
  white-space: nowrap;
  box-sizing: border-box;
}