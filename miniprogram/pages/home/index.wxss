page {
  background-color: #FFF5F5;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  font-family: PingFang SC;
}

/* 今日奶量卡片 */
.today-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.today-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.today-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.amount-number {
  font-size: 100rpx;
  font-weight: 700;
  color: #FF9B9B;
  line-height: 1;
}

.amount-unit {
  font-size: 36rpx;
  color: #FF9B9B;
  margin-left: 12rpx;
}

.today-count {
  font-size: 28rpx;
  color: #999;
}

/* 功能菜单 */
.menu-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.record-icon {
  background: linear-gradient(135deg, #7EC8E3, #A8D8EA);
}

.analysis-icon {
  background: linear-gradient(135deg, #98D8AA, #B8E6C8);
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}
