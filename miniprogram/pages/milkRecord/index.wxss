page {
  background-color: #FFF5F5;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  font-family: PingFang SC;
  padding-bottom: 180rpx;
}

/* 日期导航 */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 40rpx;
}

.date-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.date-arrow.disabled {
  opacity: 0.3;
}

.arrow-icon {
  font-size: 44rpx;
  color: #FF9B9B;
  font-weight: bold;
}

.date-display {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin: 0 50rpx;
}

/* 汇总卡片 */
.summary-card {
  background: linear-gradient(135deg, #FF9B9B, #FFB5B5);
  border-radius: 28rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(255, 155, 155, 0.35);
}

.summary-total {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.summary-number {
  font-size: 100rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.summary-unit {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 12rpx;
}

.summary-count {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 记录列表 */
.record-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.record-item {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-content {
  flex: 1;
  display: flex;
  align-items: center;
}

.record-time {
  font-size: 32rpx;
  color: #666;
  width: 110rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.record-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF9B9B;
}

.record-remark {
  font-size: 26rpx;
  color: #999;
  margin-left: 20rpx;
}

.record-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.btn-edit {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #7EC8E3;
  background: #f0f8ff;
  border-radius: 10rpx;
}

.btn-delete {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #ff6b6b;
  background: #fff0f0;
  border-radius: 10rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  background: #f5f5f5;
  border-radius: 50%;
  margin: 0 auto 36rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #ccc;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 50rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9B9B, #FFB5B5);
  color: #fff;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(255, 155, 155, 0.45);
  z-index: 50;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-close {
  flex: 1;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.modal-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  font-size: 32rpx;
  color: #333;
  width: 180rpx;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 32rpx;
  color: #666;
  text-align: right;
}

.form-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  text-align: right;
}

.modal-buttons {
  display: flex;
  margin-top: 60rpx;
  gap: 36rpx;
}

.btn-cancel {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 48rpx;
  font-size: 34rpx;
  color: #666;
}

.btn-confirm {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF9B9B, #FFB5B5);
  border-radius: 48rpx;
  font-size: 34rpx;
  color: #fff;
}
